# Copy this file to "keystore.properties" (same folder) and fill in your
# real values. keystore.properties is gitignored — never commit it, and
# never commit the .keystore file it points to either.
#
# Generate the upload key once with (run this yourself, on your machine,
# not in any shared session):
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore point-counter-key.keystore \
#     -alias point-counter-key \
#     -keyalg RSA -keysize 2048 -validity 10000
# Then move the generated .keystore file into android/app/ (or update
# MYAPP_UPLOAD_STORE_FILE below to its actual path/name).
#
# Back this file and the .keystore up somewhere safe (password manager,
# encrypted drive). If you lose them you can no longer publish updates to
# the same Play Store listing under this signing key.

MYAPP_UPLOAD_STORE_FILE=point-counter-key.keystore
MYAPP_UPLOAD_KEY_ALIAS=point-counter-key
MYAPP_UPLOAD_STORE_PASSWORD=changeme
MYAPP_UPLOAD_KEY_PASSWORD=changeme
